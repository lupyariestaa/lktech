{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts/metrics-spec.test.ts",
    "scripts/order-fulfillment.test.ts",
    "scripts/download-token.test.ts",
    "scripts/order-expiry.test.ts",
    "scripts/coupon-bundle.test.ts",
    "scripts/coupon-pure.test.ts",
    "scripts/coupon-engine.test.ts",
    "scripts/coupon-analytics.test.ts",
    "scripts/promo-pure.test.ts",
    "scripts/coupon-schema.test.ts",
    "scripts/admin-nav.test.ts",
    "scripts/backup-pure.test.ts",
    "scripts/csv.test.ts",
    "scripts/seo-pure.test.ts",
    "scripts/trusted-url.test.ts",
    "scripts/settings-form-pure.test.ts",
    "scripts/seo-schema.test.ts",
    "scripts/locations.test.ts",
    "scripts/search-console.test.ts",
    "scripts/payment-metrics.test.ts",
    "scripts/order-schema.test.ts",
    "scripts/product-stock.test.ts",
    "scripts/cart-reminder.test.ts",
    "scripts/unsubscribe-token.test.ts",
    "scripts/newsletter-pure.test.ts",
    "scripts/order-status.test.ts",
    "scripts/orders-filter.test.ts",
    "scripts/review-rating.test.ts",
    "scripts/admin-audit.test.ts",
    "scripts/lead-scoring.test.ts",
    "scripts/weekly-report.test.ts",
    "scripts/loyalty.test.ts",
    "scripts/wishlist-alert.test.ts",
    "scripts/article-schema.test.ts",
    "scripts/article-taxonomy.test.ts",
