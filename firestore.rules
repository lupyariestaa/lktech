rules_version = '2';

// ===== Firestore Security Rules — LKTech =====
//
// PENTING — arsitektur data:
// Seluruh akses data (baca & tulis) dilakukan dari SERVER melalui Firebase Admin
// SDK (API route / server component). Admin SDK MELEWATI rules ini.
// Klien (browser) HANYA memakai Firebase Authentication — TIDAK pernah membaca
// atau menulis Firestore secara langsung (tidak ada pemakaian client Firestore SDK).
//
// Karena itu postur paling aman: TOLAK SEMUA akses langsung dari klien.
// Ini sekaligus menutup celah lama di mana "user yang login" (akun Google mana pun)
// diperlakukan sebagai admin oleh rules.
//
// Koleksi yang dipakai aplikasi (semua via Admin SDK): leads, media,
// media_collections, media_audit, settings, projects, articles, content, users,
// products, orders, coupons, couponCodes, downloads, carts, reviews, admin_audit.
// Subkoleksi: users/{uid}/points (ledger poin loyalitas).
// Subkoleksi: orders/{id}/emails (riwayat email), coupons/{id}/redemptions (per-user).
// Karena `match /{document=**}` menolak SEMUA akses klien (termasuk subkoleksi),
// koleksi baru otomatis ikut terlindungi — tidak perlu rule terpisah.
//
// Bila di masa depan ada fitur yang memang butuh akses Firestore dari klien,
// tambahkan rule eksplisit dengan validasi ketat (hasOnly + batas panjang) dan
// JANGAN pakai `request.auth != null` sebagai pengganti whitelist admin.
service cloud.firestore {
  match /databases/{database}/documents {

    // Default: semua akses langsung dari klien ditolak.
    // Operasi data yang sah tetap berjalan karena lewat Admin SDK di server.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
