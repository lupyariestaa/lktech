# ===== Firebase =====
# Diperlukan agar form kontak menyimpan lead ke Firestore.
# Bila dikosongkan, form otomatis memakai fallback kirim via WhatsApp.
# Ambil nilai dari Firebase Console → Project Settings → General → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin SDK (server-only, JANGAN pakai prefix NEXT_PUBLIC_) =====
# Untuk verifikasi admin di API route & pengelolaan lead.
# Ambil dari: Project Settings → Service Accounts → Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tempel private key lengkap. Baris baru boleh ditulis sebagai \n.
FIREBASE_ADMIN_PRIVATE_KEY=

# Daftar email admin yang boleh mengakses dashboard (pisahkan dengan koma).
ADMIN_EMAILS=admin@lktech.id

# ===== Cloudinary =====
# Untuk upload gambar (portofolio/banner) via signed upload dari dashboard admin.
# Ambil dari: Cloudinary Console → Dashboard (cloud name, API key, API secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# API SECRET bersifat rahasia & hanya dipakai di server untuk menandatangani upload.
CLOUDINARY_API_SECRET=

# ===== WhatsApp =====
# Format internasional tanpa tanda + (mis. 6281234567890).
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# ===== Site (SEO) =====
# URL produksi untuk canonical, sitemap, dan Open Graph.
# Dipakai hanya di server — tidak perlu prefix NEXT_PUBLIC_.
# (NEXT_PUBLIC_SITE_URL juga didukung untuk kompatibilitas.)
# Contoh: https://lktech.vercel.app atau https://lktech.id
SITE_URL=https://lktech.id

# ===== Notifikasi Email (Resend) =====
# Daftar di https://resend.com → API Keys → Create API Key.
RESEND_API_KEY=
# Pengirim. Untuk uji cepat pakai "LKTech <onboarding@resend.dev>".
# Setelah domain diverifikasi, ganti mis. "LKTech <notifikasi@lktech.id>".
EMAIL_FROM=LKTech <onboarding@resend.dev>
# Email penerima notifikasi lead (pisahkan dengan koma bila lebih dari satu).
LEAD_NOTIFY_EMAILS=lupyariestaa@gmail.com
# (Opsional) Alamat balasan (reply-to) untuk email transaksional ke pembeli,
# agar balasan pembeli masuk ke admin. Bila kosong, tidak diisi.
ORDER_REPLY_TO=

# ===== Mayar.id (Pembayaran Online) — FASE P0 =====
# Bila MAYAR_API_KEY kosong, checkout online NONAKTIF (order tetap dibuat
# sebagai "menunggu_bayar" tanpa link bayar; alur WhatsApp tetap tersedia).
# 1) Buat akun di https://web.mayar.id (produksi) atau https://web.mayar.io (sandbox)
# 2) Buat API Key (Read & Write) di halaman /api-keys → salin ke MAYAR_API_KEY.
MAYAR_API_KEY=
# sandbox | production — menentukan base URL default (jangan hardcode).
MAYAR_MODE=sandbox
# (Opsional) Override base URL penuh, mis. https://api.mayar.id/hl/v2
MAYAR_BASE_URL=
# (Opsional) Berapa lama invoice berlaku (menit) sebelum kedaluwarsa.
MAYAR_INVOICE_TTL_MINUTES=1440
# (Opsional, disarankan) Shared-secret untuk memverifikasi webhook Mayar.
# Bila diisi, URL webhook wajib menyertakan ?token=<nilai> (atau header
# x-webhook-token). Daftarkan URL: https://<domain>/api/webhooks/mayar?token=<nilai>
MAYAR_WEBHOOK_TOKEN=

# ===== Unduhan Produk Digital (FASE P1) =====
# Secret HMAC untuk token unduhan. Bila kosong, fallback ke MAYAR_API_KEY.
# Setel nilai acak panjang, mis. hasil `openssl rand -base64 32`.
DOWNLOAD_TOKEN_SECRET=
# Masa berlaku link unduhan (hari) & batas jumlah unduh per link.
DOWNLOAD_LINK_DAYS=30
DOWNLOAD_MAX_HITS=5

# ===== Kedaluwarsa Order Otomatis (FASE P2) =====
# Secret untuk endpoint cron /api/cron/expire-orders. BILA KOSONG, endpoint
# NONAKTIF (fail-closed, balas 503) agar tidak bisa dipicu sembarang orang.
# Setel nilai acak, lalu panggil berkala dari LUAR (mis. cron-job.org, GitHub
# Actions, UptimeRobot) ke: GET /api/cron/expire-orders?token=<nilai>
# atau dengan header: Authorization: Bearer <nilai>.
# (Fitur Vercel Cron bawaan butuh plan Pro; pakai cron eksternal bila Hobby.)
CRON_SECRET=

# ===== Pengingat Keranjang Terbengkalai (FASE P5) =====# Secret HMAC untuk menandatangani tautan "berhenti diingatkan" (opt-out) pada
# email pengingat keranjang. Bila kosong → fallback DOWNLOAD_TOKEN_SECRET /
# MAYAR_API_KEY; bila ketiganya kosong, endpoint opt-out fail-closed (503).
CART_UNSUB_SECRET=
# Cron pengingat keranjang dipanggil dari cron eksternal (reuse CRON_SECRET):
#   GET /api/cron/cart-reminders?token=<CRON_SECRET>   (mis. tiap 3 jam)

# ===== Laporan Mingguan Otomatis (FASE L4) =====# Dikirim ke LEAD_NOTIFY_EMAILS via Resend, dijadwalkan dari cron eksternal
# (reuse CRON_SECRET). Jendela default 7 hari (opsional ?days=7..90):
#   GET /api/cron/weekly-report?token=<CRON_SECRET>    (mis. tiap Senin 08:00)

# ===== Newsletter & Broadcast (Tema 2.2) =====
# Secret HMAC untuk tautan berhenti-berlangganan newsletter. Bila kosong →
# fallback DOWNLOAD_TOKEN_SECRET / MAYAR_API_KEY; ketiganya kosong = fail-closed.
NEWSLETTER_UNSUB_SECRET=

# ===== Rate-limit Terdistribusi (Upstash Redis) — opsional (FASE P6/Tema 4.2) =====
# Bila diisi, rate-limit endpoint publik memakai Upstash (benar di serverless
# multi-instance). Bila kosong → fallback otomatis ke in-memory (per-instance).
# Daftar gratis di https://upstash.com → Redis Database → REST API.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ===== Sentry (Error Tracking) — opsional =====# Bila dikosongkan, Sentry NONAKTIF (tidak ada event dikirim) — aman.
# 1) Buat project Next.js di https://sentry.io
# 2) Salin DSN ke NEXT_PUBLIC_SENTRY_DSN (client) — boleh terpublikasi.
NEXT_PUBLIC_SENTRY_DSN=
# Kosongkan bila tidak mengunggah source map. Untuk upload source map,
# isi SENTRY_ORG, SENTRY_PROJECT, dan SENTRY_AUTH_TOKEN (rahasia, jangan commit).
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
