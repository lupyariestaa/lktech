# ===== Firebase =====
# Diperlukan agar form kontak menyimpan lead ke Firestore.
# Bila dikosongkan, form otomatis memakai fallback kirim via WhatsApp.
# Ambil nilai dari Firebase Console → Project Settings → General → Your apps.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ===== Firebase Admin SDK (server-only, JANGAN pakai prefix NEXT_PUBLIC_) =====
# Untuk verifikasi admin di API route & pengelolaan lead.
# Ambil dari: Project Settings → Service Accounts → Generate new private key.
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
# Tempel private key lengkap. Baris baru boleh ditulis sebagai \n.
FIREBASE_ADMIN_PRIVATE_KEY=

# Daftar email admin yang boleh mengakses dashboard (pisahkan dengan koma).
ADMIN_EMAILS=admin@lktech.id

# ===== Cloudinary =====
# Untuk upload gambar (portofolio/banner) via signed upload dari dashboard admin.
# Ambil dari: Cloudinary Console → Dashboard (cloud name, API key, API secret).
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
# API SECRET bersifat rahasia & hanya dipakai di server untuk menandatangani upload.
CLOUDINARY_API_SECRET=

# ===== WhatsApp =====
# Format internasional tanpa tanda + (mis. 6281234567890).
NEXT_PUBLIC_WHATSAPP_NUMBER=6281234567890

# ===== Site (SEO) =====
# URL produksi untuk canonical, sitemap, dan Open Graph.
# Dipakai hanya di server — tidak perlu prefix NEXT_PUBLIC_.
# (NEXT_PUBLIC_SITE_URL juga didukung untuk kompatibilitas.)
# Contoh: https://lktech.vercel.app atau https://lktech.id
SITE_URL=https://lktech.id
